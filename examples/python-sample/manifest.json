{
  "id": "sample-python-doubler",
  "version": "1.0.0",
  "purpose": "Demonstrates retained Python component support.",
  "runtime": "python",
  "entrypoint": "component.py",
  "test": "test.py",
  "mutationTest": "mutation_test.py",
  "inputs": [
    {
      "name": "value",
      "type": "finite-number",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "finite-number"
    }
  ],
  "interfaces": [
    "CVAS.Component/1"
  ],
  "preconditions": [
    "value is numeric"
  ],
  "postconditions": [
    "value is doubled"
  ],
  "invariants": [
    "invalid input returns HOLD"
  ],
  "stateOwnership": "No persistent state.",
  "dependencies": [],
  "failureBehaviour": "HOLD",
  "replaceability": "contract-bound",
  "verification": [
    "positive",
    "negative",
    "invalid-input",
    "mutation"
  ],
  "riskClass": "A",
