{
  "id": "sample-doubler",
  "version": "1.0.0",
  "purpose": "Doubles a finite numeric input without mutating caller state.",
  "runtime": "node",
  "entrypoint": "component.js",
  "test": "test.mjs",
  "inputs": [
    {
      "name": "value",
      "type": "finite-number",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "finite-number"
    }
  ],
  "interfaces": [
    "CVAS.Component/1"
  ],
  "preconditions": [
    "input is an object",
    "value is a finite number"
  ],
  "postconditions": [
    "output value equals input value multiplied by two"
  ],
  "invariants": [
    "input is not mutated",
    "invalid input never returns OK"
  ],
  "stateOwnership": "No persistent state; input is read-only.",
  "dependencies": [],
  "failureBehaviour": "HOLD",
  "replaceability": "contract-bound",
  "verification": [
    "positive",
    "zero",
    "negative",
    "missing",
    "null",
    "NaN",
    "infinity",
    "non-object",
    "input immutability"
  ],
  "riskClass": "A",
  "license": "GPL-3.0-only",
  "copyright": "Copyright \u00a9 1993-2026 Abhishek Choudhary. All rights reserved. AyeAI\u00ae, AyeAM\u00ae and AyeCNSe\u00ae are registered trademarks of Abhishek Choudhary.",
  "mutationTest": "mutation-test.mjs"
}
